# Copy to .env outside version control. Never commit real credentials.
# Load explicitly with Node 22+ (24 LTS recommended): node --env-file=.env server.mjs
# Validate the same environment first: node --env-file=.env scripts/preflight.mjs --production
HOST=127.0.0.1
PORT=3000
ORBITA_DATA_DIR=./data
ORBITA_PUBLIC_ORIGIN=
# Exact socket IPs of your HTTPS reverse proxy, confirmed during deployment.
# Leave empty locally. Do not trust all addresses or copy a proxy list blindly.
# The proxy must set/append the real client IP in X-Forwarded-For.
ORBITA_TRUSTED_PROXY_IPS=
# Public contact shown to users and required by production preflight.
ORBITA_SUPPORT_EMAIL=

# CloudPayments merchant configuration; use the host's secret storage.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_TEST_MODE=false
# Opening live sales also requires published legal documents and both flags.
# Receipt confirmation is an operator attestation after checking fiscalization;
# this flag does not issue receipts or configure a cash register.
ORBITA_LIVE_PAYMENTS_ENABLED=false
ORBITA_RECEIPTS_CONFIRMED=false

# Transactional email (verified sender/domain at Resend).
RESEND_API_KEY=
ORBITA_MAIL_FROM=

# Admin MFA is required automatically for a configured HTTPS public site.
# Keep enabled for production; local development default is not enforced.
ORBITA_REQUIRE_ADMIN_MFA=true

# Opt-in Telegram bot delivery; configure its webhook separately.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ORBITA_NOTIFICATION_INTERVAL_SECONDS=60

# Optional automatic encrypted backup; use a separate private directory.
ORBITA_BACKUP_DIR=
ORBITA_BACKUP_PASSPHRASE=
ORBITA_BACKUP_INTERVAL_HOURS=24
ORBITA_BACKUP_KEEP=7

# Radar: no external requests by default. Seed explicit local demos with npm run seed:radar.
RADAR_ENABLED=true
RADAR_PROVIDER_MODE=off
RADAR_AI_ENABLED=false
# Optional own analysis bridge; without it Radar uses explicitly labelled rules.
RADAR_AI_ENDPOINT=
RADAR_AI_API_KEY=
RADAR_NOTIFICATIONS_ENABLED=false
RADAR_MARKET_REACTION_ENABLED=true
# Pro includes Radar; add ,exclusive only if you choose to include it in that plan.
RADAR_ALLOWED_PLANS=pro
# Optional authenticated free preview, delayed and limited; full data remains gated.
RADAR_FREE_ENABLED=false
RADAR_FREE_DELAY_SECONDS=900
RADAR_FREE_LIMIT=5

# Independent HTTPS JSON/RSS adapters. Confirm endpoint/API rights before enabling live mode.
# Endpoints must not contain credentials. Keys stay on the backend.
RADAR_EDISCLOSURE_ENABLED=false
RADAR_EDISCLOSURE_INTERVAL=5000
RADAR_EDISCLOSURE_ENDPOINT=
RADAR_EDISCLOSURE_API_KEY=
RADAR_IR_ENABLED=false
RADAR_IR_INTERVAL=30000
RADAR_IR_ENDPOINT=
RADAR_IR_API_KEY=
RADAR_NSD_ENABLED=false
RADAR_NSD_INTERVAL=60000
RADAR_NSD_ENDPOINT=
RADAR_NSD_API_KEY=
RADAR_FEDRESURS_ENABLED=false
RADAR_FEDRESURS_INTERVAL=60000
RADAR_FEDRESURS_ENDPOINT=
RADAR_FEDRESURS_API_KEY=

# Participant positions: FUTOI futures only, never spot-share ownership.
# Off by default: the page stays available to Pro/Exclusive/admin with an explicit demo.
MOEX_POSITIONS_ENABLED=true
MOEX_POSITIONS_MODE=off
# Optional server-only Bearer credential; leave blank for public ISS access.
MOEX_API_KEY=
# Shared background refresh, 60..3600 seconds. No request per browser.
MOEX_POSITIONS_INTERVAL_SECONDS=300
# Mark old market snapshots, 5..1440 minutes; never replace a failure with demo data.
MOEX_POSITIONS_STALE_MINUTES=30
