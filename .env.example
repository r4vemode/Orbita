# Copy to .env outside version control. Never commit real credentials.
# Load explicitly with Node 22+ (24 LTS recommended): node --env-file=.env server.mjs
# Validate the same environment first: node --env-file=.env scripts/preflight.mjs --production
HOST=127.0.0.1
PORT=3000
ORBITA_DATA_DIR=./data
ORBITA_PUBLIC_ORIGIN=
# Exact socket IPs of your HTTPS reverse proxy, confirmed during deployment.
# Leave empty locally. Do not trust all addresses or copy a proxy list blindly.
# The proxy must set/append the real client IP in X-Forwarded-For.
ORBITA_TRUSTED_PROXY_IPS=
# Public contact shown to users and required by production preflight.
ORBITA_SUPPORT_EMAIL=

# CloudPayments merchant configuration; use the host's secret storage.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_TEST_MODE=false
# Opening live sales also requires published legal documents and both flags.
# Receipt confirmation is an operator attestation after checking fiscalization;
# this flag does not issue receipts or configure a cash register.
ORBITA_LIVE_PAYMENTS_ENABLED=false
ORBITA_RECEIPTS_CONFIRMED=false

# Transactional email (verified sender/domain at Resend).
RESEND_API_KEY=
ORBITA_MAIL_FROM=

# Admin MFA is required automatically for a configured HTTPS public site.
# Keep enabled for production; local development default is not enforced.
ORBITA_REQUIRE_ADMIN_MFA=true

# Opt-in Telegram bot delivery; configure its webhook separately.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ORBITA_NOTIFICATION_INTERVAL_SECONDS=60

# Optional automatic encrypted backup; use a separate private directory.
ORBITA_BACKUP_DIR=
ORBITA_BACKUP_PASSPHRASE=
ORBITA_BACKUP_INTERVAL_HOURS=24
ORBITA_BACKUP_KEEP=7
