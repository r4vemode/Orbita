# Copy to deploy/.env; chmod 600 deploy/.env. Do not commit real values.
# Run compose with --env-file deploy/.env -f deploy/compose.yaml from the repo root.
# Domain only: no scheme, port, path or wildcard. DNS must point to the VPS.
ORBITA_DOMAIN=
# Existing host directories, mode 0700 and owned by container UID/GID 1000.
ORBITA_DATA_PATH=/srv/orbita/private/data
ORBITA_BACKUP_PATH=/srv/orbita/private/backups
# Required before startup: unique random value, 16..4096 characters.
# Keep a separate secure copy; losing this value makes encrypted copies unusable.
ORBITA_BACKUP_PASSPHRASE=
ORBITA_BACKUP_INTERVAL_HOURS=24
ORBITA_BACKUP_KEEP=7

# Public support contact. Blank until the owner provides it.
ORBITA_SUPPORT_EMAIL=

# No live sales at first startup. Opening sales requires published documents,
# real merchant/fiscalization checks and a passing --production preflight.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_TEST_MODE=false
ORBITA_LIVE_PAYMENTS_ENABLED=false
ORBITA_RECEIPTS_CONFIRMED=false

# Both fields stay blank until a verified transactional sender is configured.
RESEND_API_KEY=
ORBITA_MAIL_FROM=

# Optional notification bot: configure all three together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ORBITA_NOTIFICATION_INTERVAL_SECONDS=60

# External news/market sources remain off until the subscriptions and rights
# to show their data have been checked. No synthetic source is enabled here.
RADAR_ENABLED=true
RADAR_PROVIDER_MODE=off
RADAR_AI_ENABLED=false
RADAR_NOTIFICATIONS_ENABLED=false
RADAR_MARKET_REACTION_ENABLED=true
RADAR_ALLOWED_PLANS=pro
RADAR_FREE_ENABLED=false
MOEX_POSITIONS_ENABLED=true
MOEX_POSITIONS_MODE=off
MOEX_API_KEY=
